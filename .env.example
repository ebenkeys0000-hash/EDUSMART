# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this applet is hosted (e.g. https://edusmart.vercel.app).
APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL connection string for Vercel / Neon / Supabase / Railway deployments.
# If omitted, EDUSMART uses SQL_HOST, SQL_USER, SQL_PASSWORD, and SQL_DB_NAME (AI Studio Cloud SQL).
# DATABASE_URL="postgresql://user:password@host:5432/edusmart?sslmode=require"
# SQL_SSL="true"

# AUTH_SESSION_SECRET: Strong random secret (min 32 chars) used to sign email/password session tokens in production.
# AUTH_SESSION_SECRET="replace-with-32-plus-char-random-secret"

# FIREBASE_SERVICE_ACCOUNT_JSON: Optional Firebase service account JSON string for strict server-side Admin SDK certs on Vercel.
# FIREBASE_SERVICE_ACCOUNT_JSON=""

# Optional VITE_FIREBASE_* overrides if deploying with a custom Firebase web project on Vercel:
# VITE_FIREBASE_API_KEY=""
# VITE_FIREBASE_AUTH_DOMAIN=""
# VITE_FIREBASE_PROJECT_ID=""
# VITE_FIREBASE_APP_ID=""
# VITE_FIREBASE_FIRESTORE_DATABASE_ID=""
